# Sarthi Frontend Environment Variables

# Backend API URL
# In production (Vercel), point this to your deployed FastAPI backend URL
# Example: https://sarthi-backend.onrender.com/api/v1 or https://api.yourdomain.com/api/v1
# For local development with Vite proxy, use: /api/v1
VITE_API_BASE_URL=https://your-backend-api-url.com/api/v1

# Set to "false" to connect to real backend API
# Set to "true" to run in standalone mock/demo mode (works on Vercel without backend)
VITE_USE_MOCK=false

# Deployment target (defaults to vercel in vite.config.ts)
NITRO_PRESET=vercel
